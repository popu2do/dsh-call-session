      "dot": "cyan",
      "title": "前端协作看板",
      "items": [
        "Web 2D 画布呈现工作区分组列与通道分流走线",
        "前台激活 1500ms、后台降频 5000ms、隐藏 5 分钟挂起",
        "链路聚焦与脉冲发光按需呈现"
      ]
    },
    {
      "dot": "emerald",
      "title": "单播调度与会话治理",
      "items": [
        "严格 1 对 1 单播推送，防范无序广播",
        "目标状态敏感：运行态引导 steer，空闲态唤醒 followup",
        "单工作区并发运行配额上限 5"
      ]
    },
    {
      "dot": "amber",
      "title": "公共黑板与存储",
      "items": [
        "纯拉取式进程内共享，发布绝不唤醒会话",
        "容量上限 200 条，依过期、撤销、最旧顺序淘汰",
        "固定 300ms 时间窗口防抖合并原子落盘与备份同步"
      ]
    }
